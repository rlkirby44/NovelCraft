QMainWindow, QDialog { background-color: #181822; }
QWidget { color: #e0f2fe; font-family: 'Liberation Sans', 'Segoe UI', sans-serif; }
QToolBar { background-color: #12121a; border-bottom: 1px solid #2b2c46; spacing: 8px; padding: 4px; }
QToolBar QToolButton { background-color: #202130; color: #00f0ff; border: 1px solid #383a5c; border-radius: 4px; padding: 6px 12px; font-weight: bold; }
QToolBar QToolButton:hover { background-color: #2a2c44; border: 1px solid #00f0ff; color: #ffffff; }
QToolBar QToolButton:pressed { background-color: #8b5cf6; color: #ffffff; }
QToolBar QToolButton#italicButton:checked { background-color: #6d28d9; color: #ffffff; border: 1px solid #00f0ff; }
QToolBar QToolButton#italicButton:checked:hover { background-color: #8b5cf6; color: #ffffff; border: 1px solid #ffffff; }
QTreeWidget { background-color: #14141e; border: 1px solid #2b2c46; color: #cbd5e1; font-size: 13px; outline: none; }
QTreeWidget::item { padding: 6px; border-radius: 4px; }
QTreeWidget::item:hover { background-color: #222336; color: #00f0ff; }
QTreeWidget::item:selected { background-color: #6d28d9; color: #ffffff; font-weight: bold; }
QHeaderView::section { background-color: #12121a; color: #00f0ff; padding: 8px; border: none; border-bottom: 2px solid #6d28d9; font-weight: bold; font-size: 12px; text-transform: uppercase; }
QSplitter::handle { background-color: #202130; }
QSplitter::handle:hover { background-color: #00f0ff; }
QTextEdit, QLineEdit, QListWidget, QComboBox { background-color: #14141e; color: #e2e8f0; border: 1px solid #2b2c46; border-radius: 4px; padding: 4px; selection-background-color: #a855f7; selection-color: #ffffff; }
QComboBox QAbstractItemView { background-color: #14141e; color: #e2e8f0; selection-background-color: #6d28d9; }
QLineEdit:focus { border: 1px solid #00f0ff; }
QListWidget::item { padding: 6px; border-radius: 3px; }
QListWidget::item:hover { background-color: #222336; color: #00f0ff; }
QListWidget::item:selected { background-color: #6d28d9; color: #ffffff; font-weight: bold; }
QPushButton { background-color: #202130; color: #00f0ff; border: 1px solid #383a5c; border-radius: 4px; padding: 6px 14px; min-width: 60px; font-weight: bold; }
QPushButton:hover { background-color: #2a2c44; border-color: #00f0ff; color: #ffffff; }
QPushButton:pressed { background-color: #8b5cf6; color: #ffffff; }
QMenu { background-color: #181822; color: #e2e8f0; border: 1px solid #00f0ff; padding: 4px; }
QMenu::item { padding: 6px 20px; border-radius: 3px; }
QMenu::item:selected { background-color: #7c3aed; color: #ffffff; }
QMessageBox { background-color: #181822; }
QMessageBox QLabel { color: #e2e8f0; }
